# ─────────────────────────────────────────────────────────────────────────────
# AutoPost settings. Easiest: run ./install.sh — it fills in this file for you.
# Manual: copy to .env (cp .env.example .env) and fill in the blanks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the two sites live ─────────────────────────────────────────────────
# On your own computer — works for YouTube, X, LinkedIn, Bluesky, Mastodon:
#   POSTIZ_URL=http://localhost:5000   DASHBOARD_URL=http://localhost:3000
#   NOT_SECURED=true   DISABLE_SSRF_PROTECTION=true
# On a server with HTTPS — needed for TikTok, Instagram, Facebook, Threads,
# Pinterest (they download your video from your server's public address):
#   POSTIZ_DOMAIN=postiz.yourname.duckdns.org   POSTIZ_URL=https://postiz.yourname.duckdns.org
#   DASHBOARD_DOMAIN=yourname.duckdns.org       DASHBOARD_URL=https://yourname.duckdns.org
#   NOT_SECURED=   DISABLE_SSRF_PROTECTION=        (both empty)
POSTIZ_URL=http://localhost:5000
DASHBOARD_URL=http://localhost:3000
POSTIZ_DOMAIN=
DASHBOARD_DOMAIN=
# Server mode: set to https so Caddy (automatic HTTPS certificates) starts too.
COMPOSE_PROFILES=

# 127.0.0.1 = only reachable from this machine (Caddy handles the public side).
BIND_ADDRESS=127.0.0.1

# Local mode only: lets Postiz use plain http and fetch videos from localhost.
# MUST be empty on a public server.
NOT_SECURED=true
DISABLE_SSRF_PROTECTION=true

# ── Secrets (install.sh generates these; use long random letters/digits) ─────
JWT_SECRET=
POSTGRES_PASSWORD=
DASHBOARD_SECRET=

# Password for the dashboard login screen.
DASHBOARD_PASSWORD=

# Postiz API key. Leave empty: the dashboard asks for it on first start
# (Postiz → Settings → Public API → copy). Setting it here also works.
POSTIZ_API_KEY=

# ── Social network developer keys (see docs/connect-platforms.md) ────────────
# Fill in only the networks you use. After changing these, run:
#   docker compose up -d
# A network shows up in the dashboard's "Connect account" list once its keys are set.

# YouTube (Google Cloud → OAuth client "Web application")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (developers.tiktok.com → app with Login Kit + Content Posting API)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Facebook Pages + Instagram Business/Creator via a Facebook Page (developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram without a Facebook Page ("Instagram API with Instagram Login")
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads (developers.facebook.com → Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=

# X / Twitter (developer.x.com — posting is pay-per-use, about $0.015 per post)
X_API_KEY=
X_API_SECRET=

# LinkedIn (linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest (developers.pinterest.com)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Mastodon (your instance → Preferences → Development → New application)
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Bluesky needs no keys: connect it in the dashboard with your handle + an app password.

# ── Advanced ─────────────────────────────────────────────────────────────────
# Postiz version the dashboard was tested with. Change only when updating on purpose.
POSTIZ_VERSION=v2.24.0
# Max one-click posts per hour.
POSTIZ_API_LIMIT=60
